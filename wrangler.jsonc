{
  // Cloudflare settings. server/worker.js serves the game page (bundled from dist/index.html) and runs the game rooms.
  "name": "oware-king",
  "main": "server/worker.js",
  "compatibility_date": "2025-06-01",
  // The game's own web address. The workers.dev address keeps working too.
  "routes": [{ "pattern": "owareking.object91.co.za", "custom_domain": true }],
  "workers_dev": true,
  "rules": [
    { "type": "Text", "globs": ["**/*.html"], "fallthrough": true },
    { "type": "Data", "globs": ["**/*.png", "**/*.jpg"], "fallthrough": true }
  ],
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "Room" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
