{
  // Cloudflare settings. server/worker.js serves the game page (bundled from dist/index.html) and runs the game rooms.
  "name": "oware-king",
  "main": "server/worker.js",
  "compatibility_date": "2025-06-01",
  "rules": [
    { "type": "Text", "globs": ["**/*.html"], "fallthrough": true },
    { "type": "Data", "globs": ["**/*.png"], "fallthrough": true }
  ],
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "Room" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
